# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Recommended — gives access to all models (Claude, GPT, Mistral, etc.)
# Get your key at https://openrouter.ai/keys
# If set, takes priority over ANTHROPIC_API_KEY.
OPENROUTER_API_KEY="sk-or-v1-..."
# Phase 5 defaults: all Anthropic Claude family for consistency + Extended Thinking support
OPENROUTER_MODEL_FAST="anthropic/claude-haiku-4.5"          # Fast/cheap: Intent, QA, Security, Web Research
OPENROUTER_MODEL_SMART="anthropic/claude-opus-4.7"          # Smart: PM, UX Designer (deep reasoning)
OPENROUTER_MODEL_CODER="anthropic/claude-sonnet-4.6"        # Coder: best code quality + Extended Thinking
OPENROUTER_MODEL_REASONING="anthropic/claude-opus-4.7"      # Capability Planner & advanced reasoning

# ANTHROPIC_API_KEY: Alternative to OpenRouter for Claude-only access.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Connection (client-side — safe to expose)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (server-side ONLY — never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Vercel Token for deployments
VERCEL_TOKEN="your-vercel-token"

# Email Configuration (choose one)
# Option 1: Resend (recommended)
RESEND_API_KEY="your-resend-api-key"
# Option 2: Brevo (Sendinblue)
BREVO_API_KEY="your-brevo-api-key"

# Email Configuration
EMAIL_FROM="Huggy <noreply@huggy.app>"
ADMIN_EMAIL="admin@yourdomain.com"

# Admin Dashboard access — comma-separated list of authorized emails
# Only these users can access /admin and call /api/admin/stats
ADMIN_EMAILS="admin@yourdomain.com"

# RAG / Embeddings (optional but recommended)
# Used to enrich Builder prompts with retrieved doc chunks at runtime.
# Without this key, RAG silently falls back to the static knowledge base.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
EMBED_MODEL="text-embedding-3-small"

# App URL (required for emails and OAuth)
APP_URL="http://localhost:3000"

# Custom Domain Configuration (for branded preview URLs)
# Default: huggy.fun — used for preview URLs like my-app.huggy.fun
HUGGY_DOMAIN="huggy.fun"

# Web Research APIs (optional — for Capability Planner to research external APIs)
# Choose one: Tavily (recommended) or SerpAPI
TAVILY_API_KEY="tvly-..."
# SERPAPI_API_KEY="..."
